#!/bin/bash
# Builds a release of the app for this machine and packs it:
#
#   scripts/package            -> dist/herdr-app-<os>-<arch>.tar.gz
#   scripts/package <triple>   -> the same for another supported Rust target
#
# Linux: a folder holding herdr-app and the icon.
# macOS: Herdr.app, signed with APPLE_CERTIFICATE_P12 when available,
# otherwise ad hoc. The notarized DMG is a separate, non-blocking CI job.
# Windows (Git Bash): a folder holding herdr-app.exe and the icon.
# Windows has curl and tar too, so the app updates the same way.
# No core inside: the installer and the app install the core's own release
# (distribution/core-version is the oldest core this app works with).
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)

triple=${1:-}
if [[ -z $triple && $(uname -s) == Darwin ]]; then
  # A Rosetta shell can run a native ARM Rust toolchain (or the reverse).
  # Pin Cargo's target rather than naming its output from the shell's uname.
  triple=$("${RUSTC:-rustc}" -vV | sed -n 's/^host: //p')
  [[ $triple == *-apple-darwin ]] || { echo "package: cannot determine macOS Rust compiler host" >&2; exit 1; }
fi
if [[ -n $triple ]]; then
  case "$triple" in
    *-linux-*) os=linux ;;
    *-apple-darwin) os=macos ;;
    *-windows-*) os=windows ;;
    *) echo "package: unsupported target $triple" >&2; exit 1 ;;
  esac
  arch=${triple%%-*}
  bin=target/$triple/release
else
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    MINGW* | MSYS* | CYGWIN*) os=windows ;;
    *) echo "package: unsupported OS $(uname -s)" >&2; exit 1 ;;
  esac
  arch=$(uname -m)
  bin=target/release
fi
case "$arch" in
  x86_64 | amd64) arch=x86_64 ;;
  arm64 | aarch64) arch=aarch64 ;;
  *) echo "package: unsupported CPU $arch" >&2; exit 1 ;;
esac
target="$os-$arch"

if [[ $os == macos ]]; then
  min_macos=$(sed -n 's/^MACOSX_DEPLOYMENT_TARGET = "\([0-9.]*\)"$/\1/p' .cargo/config.toml)
  [[ $min_macos =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || { echo "package: missing macOS deployment target" >&2; exit 1; }
  # All release artifacts use the dependency floor, even with a host override.
  export MACOSX_DEPLOYMENT_TARGET=$min_macos
fi

sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }

echo "package: herdr-app $version for $target"
for notice in LICENSE THIRD-PARTY-NOTICES; do
  [[ -s $notice ]] || { echo "package: $notice is missing or empty" >&2; exit 1; }
done
# Only release builds update themselves (src/update.rs).
HERDR_APP_RELEASE=1 cargo build --release --locked ${triple:+--target "$triple"}

if [[ $os == macos ]]; then
  expected_arch=$arch
  [[ $arch != aarch64 ]] || expected_arch=arm64
  actual_arch=$(lipo -archs "$bin/herdr-app")
  [[ $actual_arch == "$expected_arch" ]] || { echo "package: expected $expected_arch Mach-O, found $actual_arch" >&2; exit 1; }
  actual_min=$(otool -l "$bin/herdr-app" | awk '
    $1 == "cmd" { build = ($2 == "LC_BUILD_VERSION" || $2 == "LC_VERSION_MIN_MACOSX") }
    build && ($1 == "minos" || $1 == "version") && !minimum { minimum = $2 }
    END { print minimum }')
  [[ $actual_min == "$min_macos" ]] || { echo "package: expected macOS $min_macos deployment target, found ${actual_min:-unknown}" >&2; exit 1; }
fi

if [[ $os == linux ]]; then export TMPDIR=${TMPDIR:-/var/tmp}; fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p dist
out="dist/herdr-app-$target.tar.gz"
if [[ $os == linux || $os == windows ]]; then
  dir="$work/herdr-app"
  mkdir -p "$dir"
  if [[ $os == windows ]]; then cp "$bin/herdr-app.exe" "$dir/"; else cp "$bin/herdr-app" "$dir/"; fi
  cp assets/icons/herdr-ui-icon-clean.svg "$dir/herdr-app.svg"
  cp LICENSE THIRD-PARTY-NOTICES "$dir/"
  notices_path=herdr-app/THIRD-PARTY-NOTICES
  tar -czf "$out" -C "$work" herdr-app
else
  app="$work/Herdr.app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$bin/herdr-app" "$app/Contents/MacOS/Herdr"
  cp assets/icons/Herdr.icns "$app/Contents/Resources/Herdr.icns"
  cp LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
  notices_path=Herdr.app/Contents/Resources/THIRD-PARTY-NOTICES
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Herdr</string>
    <key>CFBundleIdentifier</key><string>dev.herdr.app</string>
    <key>CFBundleName</key><string>Herdr</string>
    <key>CFBundleDisplayName</key><string>Herdr</string>
    <key>CFBundleIconFile</key><string>Herdr</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>LSMinimumSystemVersion</key><string>$min_macos</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Herdr can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Herdr can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Herdr can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
  scripts/mac-sign "$app"
  tar -czf "$out" -C "$work" Herdr.app
fi
tar -xOf "$out" "$notices_path" | cmp - THIRD-PARTY-NOTICES
license_path="${notices_path%/*}/LICENSE"
tar -xOf "$out" "$license_path" | cmp - LICENSE
echo "package: $out ($(sha256 "$out"))"
