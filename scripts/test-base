#!/usr/bin/env bash
# Run vendored gpui-base unit tests against Herdr's patched vendored GPUI crates
# without dirtying vendor/gpui-kit/ with a nested Cargo.lock or target/.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
ws="$root/target/gpui-base-test-ws"
target_dir="$root/target/gpui-base-test"

extra=()
if [ "${1:-}" = "--no-opt" ]; then
  extra+=(--config 'profile.dev.package."*".opt-level=0')
  shift
fi

mkdir -p "$ws"
ln -sfn "$root/vendor/gpui-kit/crates" "$ws/crates"

manifest="$ws/Cargo.toml"
manifest_tmp="$ws/Cargo.toml.new"
cat "$root/vendor/gpui-kit/Cargo.toml" > "$manifest_tmp"
cat >> "$manifest_tmp" << EOF

[patch.crates-io]
gpui-pre = { path = "$root/vendor/gpui-pre" }
gpui-pre-wgpu = { path = "$root/vendor/gpui-pre-wgpu" }
gpui-pre-linux = { path = "$root/vendor/gpui-pre-linux" }
gpui-pre-apple = { path = "$root/vendor/gpui-pre-apple" }
gpui-pre-macos = { path = "$root/vendor/gpui-pre-macos" }
gpui-pre-windows = { path = "$root/vendor/gpui-pre-windows" }
zed-xim = { path = "$root/vendor/zed-xim" }
xim-ctext = { path = "$root/vendor/xim-ctext" }
EOF

if [ ! -f "$manifest" ] || ! cmp -s "$manifest_tmp" "$manifest"; then
  mv "$manifest_tmp" "$manifest"
else
  rm -f "$manifest_tmp"
fi

exec cargo test \
  --manifest-path "$manifest" \
  --target-dir "$target_dir" \
  "${extra[@]}" \
  -p gpui-base --lib "$@"
