[package]
name = "gpui-pre-windows"
version = "0.3.8"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Zed's `gpui_windows` crate (gpui-pre snapshot of zed@279fe07)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.cargo-shear]
ignored = ["scap"]

[package.metadata.gpui-pre]
zed-crate = "gpui_windows"
zed-version = "0.1.0"
zed-rev = "279fe070bb389b79652e52065b2f001edcc0b11b"

[lib]
path = "src/gpui_windows.rs"
doctest = false
name = "gpui_windows"

[features]
default = ["gpui/default"]
test-support = ["gpui/test-support"]
screen-capture = ["gpui/screen-capture", "scap"]

[dependencies]
gpui = { workspace = true }

[target.'cfg(target_os = "windows")'.dependencies]
accesskit = { workspace = true }
accesskit_windows = { workspace = true }
anyhow = { workspace = true }
collections = { workspace = true }
dunce = { workspace = true }
etagere = { workspace = true }
futures = { workspace = true }
gpui_util = { workspace = true }
image = { workspace = true }
itertools = { workspace = true }
log = { workspace = true }
parking_lot = { workspace = true }
rand = { workspace = true }
raw-window-handle = { workspace = true }
scheduler = { workspace = true }
smallvec = { workspace = true }
uuid = { workspace = true }
windows = { workspace = true, features = ["Win32_System_StationsAndDesktops"] }
windows-core = { workspace = true }
windows-numerics = "0.3"
windows-registry = { workspace = true }
scap = { workspace = true, optional = true }

[target.'cfg(target_os = "windows")'.build-dependencies]
windows-registry = { workspace = true }

[lints]
workspace = true
