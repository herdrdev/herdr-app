# Explicit interface messages. Variables are user data; never translate their values.
window-no-space = 尚未打开空间。新建一个{ $key }。
window-mod-failed = { $name } 加载失败：

    { $error }

    请修复文件；保存后 Herdr 会重试。
window-what-changed = 查看更新内容
window-open-updates = 打开更新设置
window-missing-mods-title = { $name } 需要尚未安装的 mod
window-missing-mods-body = 已改为显示 Herdr。缺少：{ $mods }。你的 { $name } 布局文件仍然保留。
window-edits-title = 你的编辑已保存在 { $name }
window-edits-body = Herdr 的内置布局和 mod 无法直接修改，请复制一份进行自定义。
window-command-failed = { $name } 执行失败
window-rename-space = 重命名空间
window-space-name-hint = 留空：使用文件夹名称
window-rename-tab = 重命名标签页
window-tab-name-hint = 留空：使用标签页编号
window-close-space-detail = { $name } — 标签页：{ $tabs }，终端：{ $terminals }
window-close-space = 关闭空间？
window-terminal-failed = 终端启动失败
window-agent = 一个 Agent
window-no-agents = 还没有 Agent。在终端中启动 claude、codex 或 pi。
window-restart = 重启
window-layout-unavailable = 布局不可用
window-layout-changed = 布局已在其他屏幕更改
window-layout-other-screen = 已显示其他屏幕的布局。
window-pane-change-failed = 无法更改终端窗格
window-this-machine = 这台机器
window-agent-blocked = { $name } 需要你
window-agent-finished = { $name } 已完成
window-core-update-failed = herdr-core 更新失败：{ $error } · 打开更新设置
window-updates-ready = Herdr { $app } 和 herdr-core { $core } 已就绪
window-app-ready = Herdr { $version } 已就绪
window-core-ready = herdr-core { $version } 已就绪
window-updated = 已更新至 { $version }
window-no-update-ready = 还没有可用的更新
window-couldn-t-replace-files = 无法替换 Herdr 的文件：{ $error }。
window-close-terminals-and-retry = 关闭 Herdr 的终端（或重启 Windows）后重试。{ $reason }
